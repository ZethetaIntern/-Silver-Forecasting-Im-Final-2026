      "source": [
        "import yfinance as yf, pandas as pd, numpy as np, matplotlib.pyplot as plt\n",
        "from statsmodels.tsa.arima.model import ARIMA\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "df = yf.download('SI=F', period='1y')\n",
        "df = df.reset_index()\n",
        "df = pd.DataFrame({'Date':df['Date'], 'Close':df['Close'].values.flatten()})\n",
        "\n",
        "train, test = df[:-30], df[-30:]\n",
        "h = list(train['Close'])\n",
        "p = []\n",
        "\n",
        "for i in range(len(test)):\n",
        "    f = ARIMA(h, order=(5,1,1)).fit()\n",
        "    p.append(f.forecast(steps=1)[0])\n",
        "    h.append(test['Close'].iloc[i])\n",
        "\n",
        "# Move RMSE calculation and plotting outside the loop\n",
        "rmse = np.sqrt(mean_squared_error(test['Close'], p))\n",
        "print(f\"Day3 RMSE was 7.21 -> Day4 NEW RMSE: {rmse}\")\n",
        "\n",
        "plt.figure(figsize=(10,4))\n",
        "plt.plot(test['Date'], test['Close'], label='Real')\n",
        "plt.plot(test['Date'], p, label='Predicted Day4')\n",
        "plt.legend()\n",
        "plt.title(f'Silver Improved - RMSE {rmse:.2f}')\n",
        "plt.show()"
